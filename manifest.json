{
  "name": "VIKAZE",
  "description": "Sponsored by VIKAZE",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "webview.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/storageUtils.js"],
      "run_at": "document_idle"
    },
    {
      "js": ["scripts/gnomio.js"],
      "matches": [
        "https://*.gnomio.com/*"
      ]
    },
    {
      "js": ["scripts/jak.js"],
      "matches": [
        "https://*.jttehnikums.lv/*",
        "https://jttehnikums.lv/*",
        "https://jak.lv/"
      ]
    }
  ]
}